# Copy this file to .env at the repository root. Do not commit .env.
# Use a separate local MySQL account with only the permissions needed by this app.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=driver_monitor_user
DB_PASSWORD=replace_with_your_local_password
DB_NAME=driver_monitor

# Local development ONLY: API has no login/authorization checks.
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
SERVER_DEBUG=false
